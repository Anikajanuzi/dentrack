generator client { provider = "prisma-client-js" }
datasource db { provider = "postgresql"; url = env("DATABASE_URL") }
enum Role { ADMIN LAB_MANAGER TECHNICIAN }
enum CaseStatus { RECEIVED DESIGN PRODUCTION FINISHING QUALITY_CONTROL READY DELIVERED CANCELLED ARCHIVED }
enum Priority { LOW NORMAL HIGH URGENT }
model User { id String @id @default(cuid()) name String email String @unique passwordHash String role Role @default(TECHNICIAN) active Boolean @default(true) cases Case[] @relation("Technician") createdCases Case[] @relation("Creator") createdAt DateTime @default(now()) updatedAt DateTime @updatedAt }
model Client { id String @id @default(cuid()) name String @db.VarChar(160) email String phone String active Boolean @default(true) patients Patient[] cases Case[] createdAt DateTime @default(now()) updatedAt DateTime @updatedAt @@index([name,active]) }
model Patient { id String @id @default(cuid()) firstName String lastName String clientId String client Client @relation(fields:[clientId],references:[id]) cases Case[] createdAt DateTime @default(now()) updatedAt DateTime @updatedAt @@index([clientId]) }
model Tray { id String @id @default(cuid()) trayNumber String @unique maintenanceMode Boolean @default(false) notes String? lastUsedAt DateTime? cases Case[] createdAt DateTime @default(now()) updatedAt DateTime @updatedAt }
model CaseType { id String @id @default(cuid()) name String @unique active Boolean @default(true) cases Case[] createdAt DateTime @default(now()) }
model Case { id String @id @default(cuid()) caseNumber String @unique clientId String patientId String trayId String? caseTypeId String technicianId String? createdById String status CaseStatus @default(RECEIVED) priority Priority @default(NORMAL) dateReceived DateTime dueDate DateTime completedAt DateTime? deliveredAt DateTime? archivedAt DateTime? finalPrice Decimal? @db.Decimal(12,2) materialCost Decimal @default(0) @db.Decimal(12,2) laborCost Decimal @default(0) @db.Decimal(12,2) otherCost Decimal @default(0) @db.Decimal(12,2) client Client @relation(fields:[clientId],references:[id]) patient Patient @relation(fields:[patientId],references:[id]) tray Tray? @relation(fields:[trayId],references:[id]) caseType CaseType @relation(fields:[caseTypeId],references:[id]) technician User? @relation("Technician",fields:[technicianId],references:[id]) createdBy User @relation("Creator",fields:[createdById],references:[id]) history CaseStageHistory[] createdAt DateTime @default(now()) updatedAt DateTime @updatedAt @@index([status,dueDate]) @@index([clientId,patientId]) @@index([trayId]) }
model CaseStageHistory { id String @id @default(cuid()) caseId String stage CaseStatus startedAt DateTime @default(now()) completedAt DateTime? case Case @relation(fields:[caseId],references:[id]) @@index([caseId,startedAt]) }
